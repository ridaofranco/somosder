<!doctype html>
<html lang="es">
<head><meta charset="utf-8"><title>DER · Tarjeta QR</title>
<link rel="stylesheet" href="../src/print.css">
<style>
  @page { size: 91mm 61mm; margin: 0; }
  /* 85x55 mm + 3 mm de sangrado; zona segura a 6 mm del borde del archivo */
  .card2 { width: 91mm; height: 61mm; position: relative; overflow: hidden; page-break-after: always; }
  .card2:last-child { page-break-after: auto; }
</style></head>
<body style="padding:0">
<div class="card2" style="background:var(--ink);color:#fff">
  <img src="../assets/img/der-logo-white.png" style="position:absolute;left:8mm;top:8mm;height:7mm" alt="DER">
  <div style="position:absolute;left:8mm;bottom:8mm;right:8mm">
    <div class="display" style="font-size:9pt;line-height:1.3">Eventos que <span class="accent">representan</span><br>a un país.</div>
    <div style="font-size:6pt;letter-spacing:.2em;text-transform:uppercase;color:#999;margin-top:2mm;font-weight:600">Producción integral · Buenos Aires</div>
  </div>
  <div style="position:absolute;right:0;top:0;width:3mm;height:61mm;background:var(--orange)"></div>
</div>
<div class="card2" style="background:#fff">
  <div style="position:absolute;left:8mm;top:8mm;right:36mm">
    <div style="font-size:6pt;letter-spacing:.24em;text-transform:uppercase;color:var(--orange);font-weight:600;margin-bottom:2mm">Contacto</div>
    <div style="font-size:7.6pt;line-height:1.75">
      {{ c.whatsapp }}<br>{{ c.mail }}<br>{{ c.web }}<br><span class="muted">{{ c.address }}</span><br><span class="muted">{{ c.instagram }}</span>
    </div>
  </div>
  <div style="position:absolute;right:8mm;top:9mm;text-align:center">
    <div style="width:24mm;height:24mm"><img src="../assets/img/qr/portfolio.svg" style="width:100%;height:100%" alt=""></div>
    <div style="font-size:5.5pt;color:var(--muted);margin-top:1mm">Portfolio</div>
  </div>
  <img src="../assets/img/der-logo-black.png" style="position:absolute;left:8mm;bottom:8mm;height:4.5mm" alt="DER">
  <div style="position:absolute;right:8mm;bottom:8mm;font-size:5.5pt;color:var(--muted);letter-spacing:.15em;text-transform:uppercase;font-weight:600">PASE · ENTRÁ</div>
</div>
</body></html>
